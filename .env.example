# Copy this file to .env and fill in your values. .env is git-ignored, so your
# credentials stay on this machine and the bot reads them on every start.

# --- Robinhood (required for live trading; optional in paper mode) ---
ROBINHOOD_USER=
ROBINHOOD_PASS=
# Optional: the base32 secret from Robinhood's authenticator-app 2FA setup.
# When set, the bot generates the 6-digit code itself instead of prompting.
ROBINHOOD_MFA_SECRET=

# --- Trader panel ---
# Shared key the panel sends as X-API-Key. Use the same value as
# VITE_PANEL_KEY in trader-panel/.env.
PANEL_API_KEY=

# --- TradingView alerts (optional) ---
# Any long random string. Put the same value in the "secret" field of your
# TradingView alert message so the bot only accepts your alerts.
TRADINGVIEW_WEBHOOK_SECRET=

# --- Notifications (optional) ---
DISCORD_WEBHOOK_URL=
